{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "installCommand": "bun install",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/install", "destination": "/install.sh", "permanent": false }],
  "rewrites": [{ "source": "/((?!install\\.sh|install\\.ps1|assets|robots\\.txt|sitemap\\.xml|favicon\\.svg|og\\.png|croc\\.svg).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/install.ps1",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/install.sh",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }, { "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
